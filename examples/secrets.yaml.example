# ============================================================================
# UBNT-EXPORTER EXTERNAL SECRETS CONFIGURATION (secrets.yaml)
# ============================================================================
# Referenced via 'defaults.credentials_file' in config.yaml to separate
# sensitive authentication credentials from version-controlled GitOps inventories.
#
# Recommended file permissions:
#   chmod 600 /etc/ubnt-exporter/secrets.yaml
# ============================================================================

# 1. Global default credentials (inherited by all devices unless overridden)
username: "YOUR_DEFAULT_USERNAME"
password: "YOUR_DEFAULT_PASSWORD"

# 2. Optional per-device credential overrides (matched by device 'name' or 'ip')
# Allows keeping config.yaml 100% free of plain-text passwords even when
# specific backhaul or legacy radios use dedicated administrative accounts.
devices:
  AP-BACKHAUL-01:
    username: "custom_admin"
    password: "CustomPassword123"

  # Match by RFC1918 IPv4 address if preferred:
  # "192.168.1.30":
  #   username: "legacy_admin"
  #   password: "LegacyPassword456"
